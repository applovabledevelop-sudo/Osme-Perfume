rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Admin authorization check (Bootstrapped for applovabledevelop@gmail.com)
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'applovabledevelop@gmail.com' && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'applovabledevelop@gmail.com' && isValidId(adminId));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && incoming().uid == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        incoming().uid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    // Collections Collection
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(collectionId);
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(couponId);
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) &&
        incoming().orderNumber is string && incoming().orderNumber.size() <= 64 &&
        incoming().total is number && incoming().total >= 0 &&
        incoming().customerEmail is string && incoming().customerEmail.size() <= 128;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) &&
        incoming().userId == request.auth.uid &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
        incoming().comment is string && incoming().comment.size() <= 2000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Blog / Journal Posts
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(postId);
    }

    // Contact Messages
    match /contactMessages/{messageId} {
      allow create: if isValidId(messageId) &&
        incoming().name is string && incoming().name.size() <= 128 &&
        incoming().email is string && incoming().email.size() <= 128 &&
        incoming().message is string && incoming().message.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter Subscribers
    match /newsletterSubscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) &&
        incoming().email is string && incoming().email.size() <= 128;
      allow read, update, delete: if isAdmin();
    }
  }
}
