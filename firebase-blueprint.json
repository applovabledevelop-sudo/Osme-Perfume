{
  "entities": {
    "User": {
      "title": "User",
      "description": "Customer profile and authentication record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["customer", "staff", "admin", "superadmin"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "disabled": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "Fragrance catalog item with variants, scent pyramid, and inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 4000 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "collectionId": { "type": "string", "maxLength": 64 },
        "collection": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "enum": ["unisex", "women", "men"] },
        "fragranceFamily": { "type": "string", "maxLength": 64 },
        "topNotes": { "type": "string", "maxLength": 256 },
        "heartNotes": { "type": "string", "maxLength": 256 },
        "baseNotes": { "type": "string", "maxLength": 256 },
        "size": { "type": "string", "maxLength": 32 },
        "stock": { "type": "number" },
        "lowStockThreshold": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "active": { "type": "boolean" },
        "images": { "type": "array" },
        "variants": { "type": "array" },
        "ingredients": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "slug", "price", "stock", "active"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Fragrance olfactory collection group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "slug": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 1024 },
        "active": { "type": "boolean" },
        "itemCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "slug", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shipping": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 32 },
        "shippingAddress": { "type": "object" },
        "shippingMethod": { "type": "string", "maxLength": 64 },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled", "refunded"] },
        "trackingNumber": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["orderNumber", "customerEmail", "items", "total", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount promotion coupon",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "amount": { "type": "number" },
        "minOrder": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "timesUsed": { "type": "number" },
        "expiryDate": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["code", "type", "amount", "active"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer fragrance evaluation and feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 128 },
        "comment": { "type": "string", "maxLength": 2000 },
        "verifiedPurchase": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["productId", "rating", "title", "comment"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global website branding, policies and content configurations",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 128 },
        "tagline": { "type": "string", "maxLength": 256 },
        "currency": { "type": "string", "maxLength": 8 },
        "currencySymbol": { "type": "string", "maxLength": 8 },
        "freeShippingThreshold": { "type": "number" },
        "contactEmail": { "type": "string", "maxLength": 128 },
        "contactPhone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "announcementBar": { "type": "string", "maxLength": 256 },
        "heroTitle": { "type": "string", "maxLength": 128 },
        "heroSubtitle": { "type": "string", "maxLength": 128 },
        "heroDescription": { "type": "string", "maxLength": 512 },
        "heroButtonText": { "type": "string", "maxLength": 64 },
        "heroImage": { "type": "string", "maxLength": 1024 },
        "heroBadge": { "type": "string", "maxLength": 64 },
        "aboutText": { "type": "string", "maxLength": 4000 },
        "privacyPolicy": { "type": "string", "maxLength": 8000 },
        "termsConditions": { "type": "string", "maxLength": 8000 },
        "shippingPolicy": { "type": "string", "maxLength": 8000 },
        "returnPolicy": { "type": "string", "maxLength": 8000 },
        "instagram": { "type": "string", "maxLength": 256 },
        "facebook": { "type": "string", "maxLength": 256 },
        "tiktok": { "type": "string", "maxLength": 256 },
        "pinterest": { "type": "string", "maxLength": 256 },
        "youtube": { "type": "string", "maxLength": 256 },
        "twitter": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Perfume editorial or journal article",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "slug": { "type": "string", "maxLength": 256 },
        "author": { "type": "string", "maxLength": 128 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 10000 },
        "coverImage": { "type": "string", "maxLength": 1024 },
        "published": { "type": "boolean" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "slug", "content", "published"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer inquiry submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["unread", "read", "archived"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "email", "message"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Email subscriber for boutique releases and promotions",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 128 },
        "subscribedAt": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Fragrance catalog products"
    },
    "/collections/{collectionId}": {
      "schema": { "$ref": "#/entities/Collection" },
      "description": "Fragrance collection taxonomy"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional coupon codes"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product ratings and reviews"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Global website configuration"
    },
    "/blogPosts/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Editorial journal articles"
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact inquiries"
    },
    "/newsletterSubscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter subscribers"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Admin and staff role records"
    }
  }
}
